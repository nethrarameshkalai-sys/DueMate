# DueMate Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=production
PORT=3000

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Cloud MySQL hosting options:
# - Amazon RDS: https://aws.amazon.com/rds/mysql/
# - Google Cloud SQL: https://cloud.google.com/sql
# - Azure Database for MySQL: https://azure.microsoft.com/en-us/services/mysql/
# - PlanetScale (MySQL compatible): https://planetscale.com
# - Railway.app: https://railway.app
# - Render.com: https://render.com

DB_HOST=your-database-host.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_NAME=duemate
DB_SSL=true

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins for CORS
# Example: https://duemate.netlify.app,https://yourdomain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
# Frontend URL used for password reset links and redirects
# Must match your deployed frontend domain
FRONTEND_URL=https://your-frontend-domain.com

# ============================================================
# SECURITY
# ============================================================
# Never expose this file in version control
# Use your hosting provider's secrets management system instead

# Example hosting providers' guides:
# Heroku: Add Config Vars in Settings tab
# Railway: Use Environment Variables section
# Render: Add Environment Variables
# AWS: Use Parameter Store or Secrets Manager
